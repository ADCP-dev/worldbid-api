import {
  Entity,
  PrimaryGeneratedColumn,
  Column,
  CreateDateColumn,
  UpdateDateColumn,
  Index,
  ManyToOne,
  JoinColumn,
} from 'typeorm';
import { EntityRelationalHelper } from '@infra/utils/relational-entity-helper';
import { CpProjectEntity } from './cp-project.entity';
import { CpIdeaEntity } from './cp-idea.entity';

@Entity('ext_cp_draft')
@Index(['ideaId'])
@Index(['projectId'])
export class CpDraftEntity extends EntityRelationalHelper {
  @PrimaryGeneratedColumn('uuid')
  id: string;

  @Column({ type: 'uuid' })
  ideaId: string;

  @ManyToOne(() => CpIdeaEntity, {
    eager: false,
    onDelete: 'CASCADE',
  })
  @JoinColumn({ name: 'ideaId' })
  idea: CpIdeaEntity;

  @Column({ type: 'uuid' })
  projectId: string;

  @ManyToOne(() => CpProjectEntity, {
    eager: false,
    onDelete: 'CASCADE',
  })
  @JoinColumn({ name: 'projectId' })
  project: CpProjectEntity;

  @Column({ type: 'text' })
  blogContent: string;

  @Column({ type: 'jsonb', default: {} })
  seoMetadata: Record<string, unknown>;

  @Column({ type: 'jsonb', default: [] })
  socialVariants: Record<string, unknown>[];

  @Column({ type: 'jsonb', default: [] })
  images: Record<string, unknown>[];

  @Column({ type: 'jsonb', default: [] })
  affiliateLinks: Record<string, unknown>[];

  @Column({ type: 'jsonb', default: {} })
  generationLog: Record<string, unknown>;

  @Column({ type: 'varchar', length: 20, default: 'draft' })
  status: string; // 'draft' | 'in_review' | 'approved' | 'publishing' | 'published' | 'rejected'

  @Column({ type: 'text', nullable: true })
  reviewNotes: string | null;

  @Column({ type: 'jsonb', default: {} })
  publishedTo: Record<string, unknown>;

  @Column({ type: 'timestamp', nullable: true })
  publishedAt: Date | null;

  @CreateDateColumn()
  createdAt: Date;

  @UpdateDateColumn()
  updatedAt: Date;
}