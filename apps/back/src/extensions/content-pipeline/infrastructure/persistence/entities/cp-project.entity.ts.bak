import {
  Entity,
  PrimaryGeneratedColumn,
  Column,
  CreateDateColumn,
  UpdateDateColumn,
  Index,
} from 'typeorm';
import { EntityRelationalHelper } from '@infra/utils/relational-entity-helper';

@Entity('ext_cp_project')
@Index(['slug'], { unique: true })
export class CpProjectEntity extends EntityRelationalHelper {
  @PrimaryGeneratedColumn('uuid')
  id: string;

  @Column({ type: 'varchar', length: 255 })
  name: string;

  @Column({ type: 'varchar', length: 255 })
  slug: string;

  @Column({ type: 'varchar', length: 100 })
  niche: string;

  @Column({ type: 'text', nullable: true })
  description: string | null;

  @Column({ type: 'jsonb', default: [] })
  keywords: string[];

  @Column({ type: 'text' })
  brandVoice: string;

  @Column({ type: 'text', nullable: true })
  targetAudience: string | null;

  @Column({ type: 'varchar', length: 10, default: 'es' })
  language: string;

  @Column({ type: 'jsonb', default: {} })
  authorPersona: Record<string, unknown>;

  @Column({ type: 'jsonb', default: {} })
  affiliateConfig: Record<string, unknown>;

  @Column({ type: 'jsonb', default: {} })
  socialConfig: Record<string, unknown>;

  @Column({ type: 'jsonb', default: {} })
  cmsConfig: Record<string, unknown>;

  @Column({ type: 'jsonb', default: { blog: false, social: false } })
  autoPublish: Record<string, boolean>;

  @Column({ type: 'varchar', length: 20, default: 'active' })
  status: string; // 'active' | 'paused' | 'archived'

  @CreateDateColumn()
  createdAt: Date;

  @UpdateDateColumn()
  updatedAt: Date;
}