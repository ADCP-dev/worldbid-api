<!DOCTYPE html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8' />
    <title>{{title}}</title>
    <style>
      @tailwind components;
      @tailwind utilities;

      .email-container {
        max-width: 600px;
      }
      .email-card {
        border-radius: 0.75rem;
        overflow: hidden;
      }
    </style>
  </head>

  <body class="p-0 m-0 font-sans bg-indigo-50">
    <div class="px-4 py-12 mx-auto email-container">
      <!-- Email Card -->  
      <div class="overflow-hidden bg-white rounded-xl shadow-md email-card">
        <!-- Logo Header with color band -->  
        <div class="px-6 py-4 text-center bg-gradient-to-r">
          <img
            src="{{app_url}}/assets/logo.svg"
            alt="{{app_name}}"
            class="mx-auto mt-4 w-auto h-14"
          />
        </div>
        
        <!-- Content area with padding -->  
        <div class="p-8">
          <yield />
        </div>
        
        <!-- Footer -->  
        <div class="px-8 py-6 text-sm text-center text-gray-500 bg-gray-50">
          <p>&copy; {{app_name}} - All rights reserved.</p>
        </div>
      </div>
    </div>
  </body>
</html>