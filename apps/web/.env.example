# Astro public web app — environment variables.
# Copy to .env and fill values. REVALIDATE_SECRET is shared with the NestJS backend.

# NestJS backend API base URL (no trailing slash, no /api/v1).
API_URL=http://localhost:3000

# Shared HMAC secret between NestJS (sender) and Astro (receiver).
# MUST match the backend's REVALIDATE_SECRET. Manual rotation only if compromised.
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Public canonical site URL (used for sitemap, OG tags, absolute URLs).
PUBLIC_SITE_URL=http://localhost:4321

# Astro app URL as known by the NestJS sender (where it POSTs /api/revalidate).
ASTRO_URL=http://localhost:4321

# Email that receives contact form submissions (matches backend NOTIFICATION_EMAIL).
NOTIFICATION_EMAIL=hello@example.com