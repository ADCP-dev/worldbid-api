---
import { type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const features = locale === 'en'
  ? [
      { title: 'Authentication', desc: 'JWT, roles, social login, API keys.', icon: 'key' },
      { title: 'Payments', desc: 'Stripe billing out of the box.', icon: 'card' },
      { title: 'Content', desc: 'CMS with blog, pages, SEO.', icon: 'doc' },
      { title: 'i18n', desc: 'Spanish + English, extensible.', icon: 'globe' },
      { title: 'Email', desc: 'Transactional emails via SMTP.', icon: 'mail' },
      { title: 'Storage', desc: 'S3-compatible file storage.', icon: 'cloud' },
    ]
  : [
      { title: 'Autenticación', desc: 'JWT, roles, login social, API keys.', icon: 'key' },
      { title: 'Pagos', desc: 'Facturación con Stripe lista para usar.', icon: 'card' },
      { title: 'Contenido', desc: 'CMS con blog, páginas, SEO.', icon: 'doc' },
      { title: 'i18n', desc: 'Español + Inglés, extensible.', icon: 'globe' },
      { title: 'Email', desc: 'Emails transaccionales vía SMTP.', icon: 'mail' },
      { title: 'Storage', desc: 'Almacenamiento de archivos compatible S3.', icon: 'cloud' },
    ];

const icons: Record<string, string> = {
  key: 'M10.5 10.5a3 3 0 1 1-4.243-4.243 3 3 0 0 1 4.243 4.243Zm2.121-2.121a6 6 0 0 0-8.485 0 6 6 0 0 0 0 8.485 6 6 0 0 0 8.485 0 6 6 0 0 0 0-8.485ZM18 17v-2h-2v2h-2v2h2v2h2v-2h2v-2h-2Z',
  card: 'M2 10a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-8Zm2-4h16a2 2 0 0 1 2 2v2H2V8a2 2 0 0 1 2-2Zm4 10h6v2H8v-2Z',
  doc: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Zm4 18H6V4h7v5h5v11Z',
  globe: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93Zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39Z',
  mail: 'M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z',
  cloud: 'M19.35 10.04A7.49 7.49 0 0 0 12 4a7.49 7.49 0 0 0-7.35 6.04A5.004 5.004 0 0 0 6 20h13c2.21 0 4-1.79 4-4 0-2.64-2.05-4.78-4.65-4.96ZM18 18H6c-1.66 0-3-1.34-3-3s1.34-3 3-3c.35 0 .69.06 1 .17.51-.95 1.5-1.61 2.64-1.61.96 0 1.81.43 2.39 1.1.55-.85 1.5-1.42 2.58-1.42 1.64 0 2.97 1.3 2.97 2.91v.08c.98.18 1.72 1.04 1.72 2.06 0 1.16-.94 2.1-2.1 2.1Z',
};
---

<section class="py-24 bg-base-200" id="features">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="mx-auto max-w-2xl text-center mb-16">
      <span class="badge badge-primary badge-soft mb-4">{locale === 'en' ? 'Capabilities' : 'Capacidades'}</span>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight">
        {locale === 'en' ? 'Everything you need to ship faster' : 'Todo lo que necesitás para lanzar más rápido'}
      </h2>
      <p class="mt-4 text-lg text-base-content/70">
        {locale === 'en'
          ? 'Modular extensions that work out of the box.'
          : 'Extensiones modulares que funcionan desde el primer momento.'}
      </p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((f) => (
        <div class="card bg-base-100 border border-base-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
          <div class="card-body p-6">
            <div class="mb-4 inline-flex items-center justify-center w-12 h-12 rounded-xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-content transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d={icons[f.icon]} />
              </svg>
            </div>
            <h3 class="card-title text-xl">{f.title}</h3>
            <p class="text-base-content/70 leading-relaxed">{f.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
