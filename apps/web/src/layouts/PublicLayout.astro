---
import '../styles/global.css';
import { t, DEFAULT_LOCALE } from '../i18n/ui';
import { getLocales } from '../lib/locales';

const locale = Astro.locals.locale ?? DEFAULT_LOCALE;
const activeLocales = getLocales();
const nonDefaultLocales = activeLocales.filter((l) => l !== DEFAULT_LOCALE);
// The "other" locale for the switcher — first non-default if we're on default,
// or back to default if we're on a non-default.
const otherLocale = locale === DEFAULT_LOCALE
  ? (nonDefaultLocales[0] ?? DEFAULT_LOCALE)
  : DEFAULT_LOCALE;
const otherHref = otherLocale === DEFAULT_LOCALE ? '/' : `/${otherLocale}`;

// Build href with locale prefix: default = no prefix, others = /<code>
const prefix = locale === DEFAULT_LOCALE ? '' : `/${locale}`;
const homeHref = `${prefix}/`;
const blogHref = `${prefix}/blog`;
const contactHref = `${prefix}/#contact`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body data-theme="luxury-dark">
    <nav class="navbar bg-base-100 border-b border-base-200">
      <div class="navbar-start">
        <a href={homeHref} class="btn btn-ghost gap-2 text-xl">
          <img src="/logo.svg" alt="Foundation" class="h-8 w-auto" />
          Foundation
        </a>
      </div>
      <div class="navbar-center hidden md:flex gap-2">
        <a href={homeHref} class="btn btn-ghost btn-sm">{t(locale, 'nav.home')}</a>
        <a href={blogHref} class="btn btn-ghost btn-sm">{t(locale, 'nav.blog')}</a>
        <a href={contactHref} class="btn btn-ghost btn-sm">{t(locale, 'nav.contact')}</a>
      </div>
      <div class="navbar-end gap-2">
        {nonDefaultLocales.length > 0 && (
          <a href={otherHref} class="btn btn-ghost btn-sm">{otherLocale.toUpperCase()}</a>
        )}
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer footer-center p-8 bg-base-200 text-base-content mt-16">
      <aside>
        <p>&copy; {new Date().getFullYear()} Foundation. {t(locale, 'footer.rights')}.</p>
        <div class="flex gap-4 text-sm">
          <a href="/sitemap-index.xml" class="link link-hover">Sitemap</a>
        </div>
      </aside>
    </footer>
  </body>
</html>