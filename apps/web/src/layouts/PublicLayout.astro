---
import '../styles/global.css';
import { t, DEFAULT_LOCALE } from '../i18n/ui';
import { getLocales } from '../lib/locales';

const locale = Astro.locals.locale ?? DEFAULT_LOCALE;
const activeLocales = getLocales();
const nonDefaultLocales = activeLocales.filter((l) => l !== DEFAULT_LOCALE);
const otherLocale = locale === DEFAULT_LOCALE
  ? (nonDefaultLocales[0] ?? DEFAULT_LOCALE)
  : DEFAULT_LOCALE;
const otherHref = otherLocale === DEFAULT_LOCALE ? '/' : `/${otherLocale}`;

const prefix = locale === DEFAULT_LOCALE ? '' : `/${locale}`;
const homeHref = `${prefix}/`;
const blogHref = `${prefix}/blog`;
const contactHref = `${prefix}/#contact`;

const navLinks = [
  { href: homeHref, label: t(locale, 'nav.home') },
  { href: blogHref, label: t(locale, 'nav.blog') },
  { href: contactHref, label: t(locale, 'nav.contact') },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body data-theme="luxury-dark">
    <nav class="navbar bg-base-100/80 backdrop-blur border-b border-base-200 sticky top-0 z-50">
      <div class="navbar-start gap-2">
        <div class="dropdown md:hidden">
          <button
            type="button"
            class="btn btn-ghost btn-square"
            aria-label={t(locale, 'nav.menu')}
            aria-haspopup="menu"
            aria-expanded="false"
            id="mobile-menu-button"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <ul
            role="menu"
            id="mobile-menu"
            class="menu menu-sm dropdown-content bg-base-100 rounded-box z-50 mt-3 w-52 p-2 shadow-lg border border-base-200 hidden"
          >
            {navLinks.map((link) => (
              <li><a href={link.href} role="menuitem">{link.label}</a></li>
            ))}
          </ul>
        </div>
        <a href={homeHref} class="btn btn-ghost gap-2 text-xl px-2 md:px-4">
          <img src="/logo.svg" alt="Foundation" class="h-8 w-auto" />
          <span class="hidden sm:inline">Foundation</span>
        </a>
      </div>
      <div class="navbar-center hidden md:flex gap-1">
        {navLinks.map((link) => (
          <a href={link.href} class="btn btn-ghost btn-sm">{link.label}</a>
        ))}
      </div>
      <div class="navbar-end gap-1 md:gap-2">
        {nonDefaultLocales.length > 0 && (
          <a href={otherHref} class="btn btn-ghost btn-sm uppercase tracking-wide" aria-label={`Switch to ${otherLocale}`}>
            {otherLocale}
          </a>
        )}
        <a href="/login" class="btn btn-primary btn-sm hidden sm:inline-flex">{locale === 'en' ? 'Sign in' : 'Ingresar'}</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer bg-base-200 text-base-content border-t border-base-300 mt-20 py-12 px-6">
      <div class="container mx-auto max-w-6xl">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <aside class="space-y-4">
            <a href={homeHref} class="btn btn-ghost gap-2 text-xl -ml-4">
              <img src="/logo.svg" alt="Foundation" class="h-8 w-auto" />
              Foundation
            </a>
            <p class="text-sm text-base-content/70 max-w-xs">
              {locale === 'en'
                ? 'A comprehensive platform for business integrations, built for scale.'
                : 'Una plataforma integral para integraciones de negocio, pensada para escalar.'}
            </p>
          </aside>
          <nav class="flex flex-col gap-2" aria-label="Footer">
            <h3 class="footer-title opacity-90">{locale === 'en' ? 'Links' : 'Enlaces'}</h3>
            {navLinks.map((link) => (
              <a href={link.href} class="link link-hover text-sm">{link.label}</a>
            ))}
            <a href="/sitemap-index.xml" class="link link-hover text-sm">Sitemap</a>
          </nav>
          <aside class="md:text-right flex flex-col gap-4">
            <p class="text-sm text-base-content/60">
              &copy; {new Date().getFullYear()} Foundation. {t(locale, 'footer.rights')}.
            </p>
            <div class="flex md:justify-end gap-3">
              <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-square btn-sm" aria-label="GitHub">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.1.39-1.99 1.03-2.69a3.6 3.6 0 0 1 .1-2.64s.84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.4.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12c0-5.52-4.48-10-10-10z"/></svg>
              </a>
              <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-square btn-sm" aria-label="Twitter">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            </div>
          </aside>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const btn = document.getElementById('mobile-menu-button');
        const menu = document.getElementById('mobile-menu');
        if (!btn || !menu) return;
        btn.addEventListener('click', function () {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          menu.classList.toggle('hidden', expanded);
        });
        menu.querySelectorAll('a').forEach(function (link) {
          link.addEventListener('click', function () {
            btn.setAttribute('aria-expanded', 'false');
            menu.classList.add('hidden');
          });
        });
      })();
    </script>
  </body>
</html>
