---
import PublicLayout from '../layouts/PublicLayout.astro';

const locale = Astro.locals.locale ?? 'es';
const localePrefix = locale === 'en' ? '/en' : '';
---

<PublicLayout>
  <section class="relative flex min-h-[70vh] items-center justify-center overflow-hidden px-4">
    <div class="absolute inset-0 opacity-10" aria-hidden="true">
      <svg class="h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
        <pattern id="grid500" width="10" height="10" patternUnits="userSpaceOnUse">
          <path d="M 10 0 L 0 0 0 10" fill="none" stroke="currentColor" stroke-width="0.5"></path>
        </pattern>
        <rect width="100" height="100" fill="url(#grid500)"></rect>
      </svg>
    </div>

    <div class="relative text-center max-w-lg">
      <div class="mx-auto mb-6 w-40 h-40 text-error">
        <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="100" cy="100" r="90" stroke="currentColor" stroke-width="8" stroke-opacity="0.2"></circle>
          <path d="M55 80C55 80 75 60 100 60C125 60 145 80 145 80" stroke="currentColor" stroke-width="12" stroke-linecap="round"></path>
          <path d="M60 130H140" stroke="currentColor" stroke-width="12" stroke-linecap="round"></path>
          <circle cx="70" cy="105" r="8" fill="currentColor"></circle>
          <circle cx="130" cy="105" r="8" fill="currentColor"></circle>
        </svg>
      </div>

      <h1 class="text-6xl md:text-8xl font-bold text-error">500</h1>
      <p class="mt-4 text-2xl font-semibold">{locale === 'en' ? 'Server error' : 'Error del servidor'}</p>
      <p class="mt-2 text-base-content/70">
        {locale === 'en'
          ? 'Something went wrong on our side. Please try again later.'
          : 'Algo salió mal de nuestro lado. Probá de nuevo más tarde.'}
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <button type="button" class="btn btn-primary btn-lg" onclick="window.location.reload()">
          {locale === 'en' ? 'Reload page' : 'Recargar página'}
        </button>
        <a href={`${localePrefix}/`} class="btn btn-ghost btn-lg">
          {locale === 'en' ? 'Back home' : 'Volver al inicio'}
        </a>
      </div>
    </div>
  </section>
</PublicLayout>
