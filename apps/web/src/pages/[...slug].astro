---
// CMS dynamic pages — fetch a published page by slug (FR-006, R-PWA-03).
import PublicLayout from '../layouts/PublicLayout.astro';
import Breadcrumbs from '../components/blog/Breadcrumbs.astro';
import { fetchApi, PUBLIC_API } from '../lib/api';

interface CmsPage {
  id: string;
  slug: string;
  name: string;
  isPublished: boolean;
  featuredImage?: { path?: string } | null;
  translations?: Record<string, Record<string, string>>;
  [key: string]: unknown;
}
interface SeoMeta {
  metaTitle?: string;
  metaDescription?: string;
  ogImage?: string;
  customJsonLd?: Record<string, unknown>;
}

const locale = Astro.locals.locale;
const localePrefix = locale === 'en' ? '/en' : '';

const rawSlug = Astro.params.slug ?? '';
const slug = rawSlug.replace(/^en\//, '');

const page = await fetchApi<CmsPage>(PUBLIC_API.cmsPage(slug), { lang: locale });

if (!page) {
  return Astro.redirect(`/${localePrefix}/404`);
}

const translations = page.translations?.[locale] ?? {};
const title = translations.title ?? page.name ?? page.slug;
const content = translations.content ?? (page as any).content ?? '';

const seo = await fetchApi<SeoMeta>(PUBLIC_API.seoByPageId(page.id), { lang: locale });
const metaTitle = seo?.metaTitle ?? title;
const metaDescription = seo?.metaDescription ?? translations.excerpt ?? '';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.site?.origin || '';
const cdnBase = import.meta.env.PUBLIC_CDN_BASE_URL || '';
const imageUrl = page.featuredImage?.path
  ? (cdnBase ? `${cdnBase}/${page.featuredImage.path}` : page.featuredImage.path)
  : undefined;

const crumbs = [
  { name: locale === 'en' ? 'Home' : 'Inicio', url: `${siteUrl}${localePrefix}/` },
  { name: title, url: `${siteUrl}${localePrefix}/${slug}` },
];

Astro.cache.set({ tags: ['pages'] });
---

<PublicLayout>
  <article class="container mx-auto px-4 py-12 max-w-4xl">
    <Breadcrumbs items={crumbs} locale={locale} />

    <header class="mb-10 mt-4 text-center">
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight leading-tight">{title}</h1>
      {metaDescription && <p class="mt-4 text-lg text-base-content/70 max-w-2xl mx-auto">{metaDescription}</p>}
    </header>

    {imageUrl && (
      <figure class="mb-10">
        <img src={imageUrl} alt={title} class="w-full rounded-box aspect-[21/9] object-cover shadow-lg" />
      </figure>
    )}

    <div class="prose prose-lg max-w-none" set:html={content} />
  </article>

  <Fragment slot="head">
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    {seo?.ogImage && <meta property="og:image" content={seo.ogImage} />}
    {seo?.customJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(seo.customJsonLd)} />
    )}
  </Fragment>
</PublicLayout>
