---
// Category page — 2-step slug→id orchestration (R-PWA-05, GAP3).
import PublicLayout from '../../../layouts/PublicLayout.astro';
import BlogCard from '../../../components/blog/BlogCard.astro';
import Pagination from '../../../components/blog/Pagination.astro';
import Breadcrumbs from '../../../components/blog/Breadcrumbs.astro';
import { fetchApi, PUBLIC_API } from '../../../lib/api';
import { t } from '../../../i18n/ui';

interface Category {
  id: string;
  slug: string;
  name?: string | null;
  description?: string | null;
}
interface BlogListResponse {
  data: Array<Record<string, unknown>>;
  meta: { page: number; limit: number; total: number; totalPages: number };
}

const { searchParams } = Astro.url;
const locale = Astro.locals.locale;
const localePrefix = locale === 'en' ? '/en' : '';
const slug = Astro.params.slug ?? '';

const pageParam = Number(searchParams.get('page')) || 1;
const page = Math.max(1, pageParam);
const limit = 9;

const category = await fetchApi<Category>(PUBLIC_API.blogCategoryBySlug(slug), {
  lang: locale,
});

if (!category) {
  return Astro.redirect(`/${localePrefix}/404`);
}

const result = await fetchApi<BlogListResponse>(PUBLIC_API.blogPosts, {
  lang: locale,
  searchParams: { page, limit, categoryId: category.id },
});

const posts = result?.data ?? [];
const meta = result?.meta ?? { page, limit, total: 0, totalPages: 0 };

const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.site?.origin || '';
const crumbs = [
  { name: t(locale, 'nav.home'), url: `${siteUrl}${localePrefix}/` },
  { name: t(locale, 'nav.blog'), url: `${siteUrl}${localePrefix}/blog` },
  { name: category.name ?? slug, url: `${siteUrl}${localePrefix}/blog/c/${slug}` },
];

Astro.cache.set({ tags: ['blog'] });
---

<PublicLayout>
  <section class="relative bg-base-200 border-b border-base-300 py-16 md:py-24">
    <div class="container mx-auto px-4 max-w-6xl">
      <Breadcrumbs items={crumbs} locale={locale} />
      <div class="mt-6 text-center md:text-left">
        <span class="badge badge-primary badge-soft mb-3">{locale === 'en' ? 'Category' : 'Categoría'}</span>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight">{category.name ?? slug}</h1>
        {category.description && (
          <p class="mt-3 max-w-2xl text-lg text-base-content/70">{category.description}</p>
        )}
      </div>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16 max-w-6xl">
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <BlogCard post={post as any} locale={locale} />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 bg-base-200/50 rounded-2xl border border-base-200">
        <p class="text-lg text-base-content/60">
          {locale === 'en' ? 'No posts in this category yet.' : 'No hay artículos en esta categoría.'}
        </p>
      </div>
    )}

    <Pagination
      page={meta.page}
      totalPages={meta.totalPages}
      basePath={`${localePrefix}/blog/c/${slug}`}
      locale={locale}
    />
  </section>
</PublicLayout>
