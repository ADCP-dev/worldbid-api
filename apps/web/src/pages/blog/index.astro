---
// Blog index — paginated list of published posts (FR-005/007/012, R-PWA-02/04).
import PublicLayout from '../../layouts/PublicLayout.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import Pagination from '../../components/blog/Pagination.astro';
import { fetchApi, PUBLIC_API } from '../../lib/api';
import { t } from '../../i18n/ui';

interface BlogListResponse {
  data: Array<Record<string, unknown>>;
  meta: { page: number; limit: number; total: number; totalPages: number };
}

const { searchParams } = Astro.url;
const locale = Astro.locals.locale;
const localePrefix = locale === 'en' ? '/en' : '';

const pageParam = Number(searchParams.get('page')) || 1;
const page = Math.max(1, pageParam);
const limit = 9;

const result = await fetchApi<BlogListResponse>(PUBLIC_API.blogPosts, {
  lang: locale,
  searchParams: { page, limit },
});

const posts = result?.data ?? [];
const meta = result?.meta ?? { page, limit, total: 0, totalPages: 0 };

// Set cache tags for this route (R-ISR-01). routeRules already declares 'blog'.
Astro.cache.set({ tags: ['blog', 'blog-index'] });

const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.site?.origin || '';
---

<PublicLayout>
  <section class="container mx-auto px-4 py-12 max-w-6xl">
    <header class="mb-8">
      <h1 class="text-4xl font-bold">{t(locale, 'nav.blog')}</h1>
      <p class="text-base-content/60 mt-2">
        {locale === 'en' ? 'Latest articles and updates.' : 'Últimos artículos y novedades.'}
      </p>
    </header>

    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <BlogCard post={post as any} locale={locale} />
        ))}
      </div>
    ) : (
      <p class="text-base-content/60 py-12 text-center">
        {locale === 'en' ? 'No posts published yet.' : 'Aún no hay artículos publicados.'}
      </p>
    )}

    <Pagination
      page={meta.page}
      totalPages={meta.totalPages}
      basePath={`${localePrefix}/blog`}
      locale={locale}
    />
  </section>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: t(locale, 'nav.blog'),
    url: `${siteUrl}${localePrefix}/blog`,
  })} />
</PublicLayout>