---
// Blog index — paginated list of published posts (FR-005/007/012, R-PWA-02/04).
import PublicLayout from '../../layouts/PublicLayout.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import Pagination from '../../components/blog/Pagination.astro';
import { fetchApi, PUBLIC_API } from '../../lib/api';
import { t } from '../../i18n/ui';

interface BlogListResponse {
  data: Array<Record<string, unknown>>;
  meta: { page: number; limit: number; total: number; totalPages: number };
}

const { searchParams } = Astro.url;
const locale = Astro.locals.locale;
const localePrefix = locale === 'en' ? '/en' : '';

const pageParam = Number(searchParams.get('page')) || 1;
const page = Math.max(1, pageParam);
const limit = 9;

const result = await fetchApi<BlogListResponse>(PUBLIC_API.blogPosts, {
  lang: locale,
  searchParams: { page, limit },
});

const posts = result?.data ?? [];
const meta = result?.meta ?? { page, limit, total: 0, totalPages: 0 };

Astro.cache.set({ tags: ['blog', 'blog-index'] });

const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.site?.origin || '';
---

<PublicLayout>
  <section class="relative bg-base-200 border-b border-base-300 py-20 md:py-28">
    <div class="container mx-auto px-4 max-w-6xl text-center">
      <span class="badge badge-primary badge-soft mb-4">{locale === 'en' ? 'Our blog' : 'Nuestro blog'}</span>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight">{t(locale, 'nav.blog')}</h1>
      <p class="mt-4 mx-auto max-w-2xl text-lg md:text-xl text-base-content/70">
        {locale === 'en'
          ? 'Latest articles, guides, and product updates from the team.'
          : 'Últimos artículos, guías y novedades del equipo.'}
      </p>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16 max-w-6xl">
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <BlogCard post={post as any} locale={locale} />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 bg-base-200/50 rounded-2xl border border-base-200">
        <p class="text-lg text-base-content/60">
          {locale === 'en' ? 'No posts published yet.' : 'Aún no hay artículos publicados.'}
        </p>
      </div>
    )}

    <Pagination
      page={meta.page}
      totalPages={meta.totalPages}
      basePath={`${localePrefix}/blog`}
      locale={locale}
    />
  </section>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: t(locale, 'nav.blog'),
    url: `${siteUrl}${localePrefix}/blog`,
  })} />
</PublicLayout>
