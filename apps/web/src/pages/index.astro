---
// Landing — SSR HTML with 0 client JS (R-PWA-01, FR-001/002/006).
import PublicLayout from '../layouts/PublicLayout.astro';
import Hero from '../components/landing/Hero.astro';
import Features from '../components/landing/Features.astro';
import Contact from '../components/landing/Contact.astro';
import { localeFromPath, type Locale } from '../i18n/ui';
import { organizationJsonLd, webSiteJsonLd } from '../lib/seo';

const { pathname } = Astro.url;
const locale: Locale = localeFromPath(pathname);

const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.site?.origin || '';
const orgLd = organizationJsonLd({ name: 'Foundation', url: siteUrl });
const siteLd = webSiteJsonLd('Foundation', siteUrl);

Astro.cache.set({ tags: ['home'] });
---

<PublicLayout>
  <Hero locale={locale} />
  <Features locale={locale} />
  <Contact locale={locale} />

  <Fragment slot="head">
    <title>Foundation</title>
    <meta
      name="description"
      content={locale === 'en'
        ? 'A comprehensive platform for business integrations. Authentication, payments, content, and more.'
        : 'Una plataforma integral para integraciones de negocio. Autenticación, pagos, contenido y más.'}
    />
    <meta property="og:title" content="Foundation" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
  </Fragment>
</PublicLayout>