{
  "$schema": "https://opencode.ai/config.json",
  // ─── Agent ──────────────────────────────────────────────────────────────────
  // Uses AGENTS.md as the system prompt (auto-detected by OpenCode Rules)
  "agent": {
    "foundation": {
      "description": "Foundation architect — uses AGENTS.md, SDD, and project skills",
      "mode": "primary",
      "model": "ollama-cloud/glm-5.2",
      "prompt": "{file:./AGENTS.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true,
        "task": true,
        "delegate": true,
        "delegation_read": true,
        "delegation_list": true
      },
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    // ─── Playwright Test Agents ──────────────────────────────────────────────
    "playwright-test-planner": {
      "description": "Use this agent when you need to create comprehensive test plan for a web application or website",
      "mode": "subagent",
      "prompt": "{file:.agents/prompts/playwright-test-planner.md}",
      "tools": {
        "ls": true,
        "glob": true,
        "grep": true,
        "read": true,
        "playwright-test*browser_click": true,
        "playwright-test*browser_close": true,
        "playwright-test*browser_console_messages": true,
        "playwright-test*browser_drag": true,
        "playwright-test*browser_evaluate": true,
        "playwright-test*browser_file_upload": true,
        "playwright-test*browser_handle_dialog": true,
        "playwright-test*browser_hover": true,
        "playwright-test*browser_navigate": true,
        "playwright-test*browser_navigate_back": true,
        "playwright-test*browser_network_requests": true,
        "playwright-test*browser_press_key": true,
        "playwright-test*browser_run_code": true,
        "playwright-test*browser_select_option": true,
        "playwright-test*browser_snapshot": true,
        "playwright-test*browser_take_screenshot": true,
        "playwright-test*browser_type": true,
        "playwright-test*browser_wait_for": true,
        "playwright-test*planner_setup_page": true,
        "playwright-test*planner_save_plan": true
      }
    },
    "playwright-test-generator": {
      "description": "Use this agent when you need to create automated browser tests using Playwright",
      "mode": "subagent",
      "prompt": "{file:.agents/prompts/playwright-test-generator.md}",
      "tools": {
        "ls": true,
        "glob": true,
        "grep": true,
        "read": true,
        "playwright-test*browser_click": true,
        "playwright-test*browser_drag": true,
        "playwright-test*browser_evaluate": true,
        "playwright-test*browser_file_upload": true,
        "playwright-test*browser_handle_dialog": true,
        "playwright-test*browser_hover": true,
        "playwright-test*browser_navigate": true,
        "playwright-test*browser_press_key": true,
        "playwright-test*browser_select_option": true,
        "playwright-test*browser_snapshot": true,
        "playwright-test*browser_type": true,
        "playwright-test*browser_verify_element_visible": true,
        "playwright-test*browser_verify_list_visible": true,
        "playwright-test*browser_verify_text_visible": true,
        "playwright-test*browser_verify_value": true,
        "playwright-test*browser_wait_for": true,
        "playwright-test*generator_read_log": true,
        "playwright-test*generator_setup_page": true,
        "playwright-test*generator_write_test": true
      }
    },
    "playwright-test-healer": {
      "description": "Use this agent when you need to debug and fix failing Playwright tests",
      "mode": "subagent",
      "prompt": "{file:.agents/prompts/playwright-test-healer.md}",
      "tools": {
        "ls": true,
        "glob": true,
        "grep": true,
        "read": true,
        "edit": true,
        "write": true,
        "playwright-test*browser_console_messages": true,
        "playwright-test*browser_evaluate": true,
        "playwright-test*browser_generate_locator": true,
        "playwright-test*browser_network_requests": true,
        "playwright-test*browser_snapshot": true,
        "playwright-test*test_debug": true,
        "playwright-test*test_list": true,
        "playwright-test*test_run": true
      }
    }
  },
  // Default agent
  "default_agent": "foundation",
  // ─── Global tool restrictions ──────────────────────────────────────────────
  // Playwright tools restricted to dedicated test agents only
  "tools": {
    "playwright*": true
  },
  // ─── MCP Servers ────────────────────────────────────────────────────────────
  // Remote MCPs (always available, no local setup)
  "mcp": {
    // Context7 — search library docs (free)
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    // Engram — persistent memory for agents (local)
    "engram": {
      "type": "local",
      "command": ["engram", "mcp", "--tools=agent"],
      "enabled": true
    },
    // Tavily — web search, extract, crawl (remote MCP)
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
      "enabled": true
    },
    // Nuxt SEO — sitemap, OG image, schema.org diagnostics (remote MCP)
    "nuxt-seo": {
      "type": "remote",
      "url": "https://nuxtseo.com/mcp",
      "enabled": true
    },
    // PostgreSQL — local database access (reads from apps/back/.env)
    "postgres": {
      "type": "local",
      "command": ["bash", "-c", "set -a; source <(grep -v '^#' apps/back/.env | sed 's/^/export /'); npx -y mcp-postgres \"postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}\""],
      "enabled": true
    },
    // Stripe — payment processing MCP
    "stripe": {
      "type": "local",
      "command": ["npx", "-y", "@stripe/mcp", "--api-key={env:STRIPE_SECRET_KEY}"],
      "enabled": true
    },
    // Playwright Test — E2E test generation & healing MCP
    "playwright-test": {
      "type": "local",
      "command": ["npx", "playwright", "run-test-mcp-server"],
      "enabled": true
    },
    // DaisyUI Docs — component and theme documentation via gitmcp
    "daisyui-docs": {
      "type": "remote",
      "url": "https://gitmcp.io/saadeghi/daisyui",
      "enabled": true
    }
  },
  // ─── Plugins ────────────────────────────────────────────────────────────────
  "plugin": [
    ".agents/plugins/graphify.js"
  ],
  // ─── Instructions (auto-loaded into system prompt) ──────────────────────────
  "instructions": [
    "docs/ARCHITECTURE.md",
    "docs/TOOLS.md",
    ".agents/generated.json"
  ],
  // ─── Permissions ────────────────────────────────────────────────────────────
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git push --force *": "ask"
    },
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny"
    }
  },
  // ─── Shell ──────────────────────────────────────────────────────────────────
  "shell": "pwsh",
  // ─── Compaction ─────────────────────────────────────────────────────────────
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "lsp": true
}
