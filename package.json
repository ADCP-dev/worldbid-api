{
  "name": "foundation",
  "private": true,
  "scripts": {
    "assets:sync": "node scripts/sync-assets.js",
    "email:test": "node scripts/test-email.js",
    "email:test-reset": "node scripts/test-email.js reset-password",
    "email:test-confirm": "node scripts/test-email.js confirm-new-email",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "docs:sync": "node bin/sync-docs.js",
    "obsidian:sync": "node bin/sync-obsidian.js",
    "worktree:spawn": "node bin/spawn-worktree.js",
    "worktree:cleanup": "node bin/cleanup-worktree.js"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
